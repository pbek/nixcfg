Subject: [PATCH] Add Just syntax highlighting

---
 autotests/input/justfile         |  36 +++++
 autotests/reference/justfile.ref |  36 +++++
 data/syntax/just.xml             | 234 +++++++++++++++++++++++++++++++
 3 files changed, 306 insertions(+)
 create mode 100644 autotests/input/justfile
 create mode 100644 autotests/reference/justfile.ref
 create mode 100644 data/syntax/just.xml

diff --git a/autotests/input/justfile b/autotests/input/justfile
new file mode 100644
index 00000000..c9f2231c
--- /dev/null
+++ b/autotests/input/justfile
@@ -0,0 +1,36 @@
+# Variables, strings, functions, and settings
+set dotenv-load
+set shell := ["bash", "-uc"]
+export version := "1.2.3"
+archive := 'app-' + version + ".tar.gz"
+triple := """
+  multiple lines
+"""
+home := env("HOME")
+checked := if path_exists(home) { home } else { error("missing home") }
+command := `git rev-parse --short HEAD`
+
+alias b := build
+import? 'local.just'
+mod tools 'tools.just'
+
+[doc('Build the project')]
+[group('development')]
+build $target='debug' *flags: clean (prepare target) && lint
+    @echo "building {{ target }} {{ archive }}"
+    cargo build --profile {{ if target == 'debug' { 'dev' } else { target } }} {{ flags }}
+
+[no-cd]
+[script("python3", "-u")]
+script name:
+    #!/usr/bin/env python3
+    print("Hello, {{ name }}!")
+
+clean:
+    -rm -rf target
+
+prepare target:
+    echo preparing {{ target }}
+
+lint:
+    cargo clippy
