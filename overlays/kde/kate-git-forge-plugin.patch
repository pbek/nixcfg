+KateGitForgePluginView::KateGitForgePluginView(KateGitForgePlugin *plugin, KTextEditor::MainWindow *mainWindow)
+    : QObject(mainWindow)
+    , m_plugin(plugin)
+    , m_mainWindow(mainWindow)
+{
+    KXMLGUIClient::setComponentName(QStringLiteral("kategitforgeplugin"), i18n("Git Forge"));
+    setXMLFile(QStringLiteral("ui.rc"));
+
+    m_editorMenu = new KActionMenu(QIcon::fromTheme(QStringLiteral("vcs-branch")), i18n("Git Forge"), this);
+    actionCollection()->addAction(QStringLiteral("popup_git_forge"), m_editorMenu);
+    m_openAction = m_editorMenu->menu()->addAction(QIcon::fromTheme(QStringLiteral("internet-web-browser")), i18n("Open on Git Forge"));
+    m_copyAction = m_editorMenu->menu()->addAction(QIcon::fromTheme(QStringLiteral("edit-copy")), i18n("Copy Git Forge Link"));
+
+    connect(m_editorMenu->menu(), &QMenu::aboutToShow, this, &KateGitForgePluginView::updateEditorActions);
+    connect(m_openAction, &QAction::triggered, this, &KateGitForgePluginView::openActiveViewLink);
+    connect(m_copyAction, &QAction::triggered, this, &KateGitForgePluginView::copyActiveViewLink);
+    connect(m_mainWindow, &KTextEditor::MainWindow::pluginViewCreated, this, &KateGitForgePluginView::slotPluginViewCreated);
+    connect(m_mainWindow, &KTextEditor::MainWindow::pluginViewDeleted, this, &KateGitForgePluginView::slotPluginViewDeleted);
+
+    slotPluginViewCreated(QStringLiteral("kateprojectplugin"), m_mainWindow->pluginView(QStringLiteral("kateprojectplugin")));
+    m_mainWindow->guiFactory()->addClient(this);
+}
