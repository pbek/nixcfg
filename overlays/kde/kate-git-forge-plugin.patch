+QString runGit(const QString &repository, const QStringList &arguments)
+{
+    QProcess process;
+    if (!setupGitProcess(process, repository, arguments)) {
+        return {};
+    }
+    startHostProcess(process, QIODevice::ReadOnly);
+    if (!process.waitForStarted(3000) || !process.waitForFinished(3000)) {
+        process.kill();
+        process.waitForFinished();
+        return {};
+    }
+    if (process.exitStatus() != QProcess::NormalExit || process.exitCode() != 0) {
+        return {};
+    }
+    return QString::fromUtf8(process.readAllStandardOutput().trimmed());
+}
+
+QStringList remoteNames(const QString &repository)
+{
+    return runGit(repository, {QStringLiteral("remote")}).split(u'\n', Qt::SkipEmptyParts);
+}
+
+std::optional<GitForge::LineRange> activeLines(KTextEditor::View *view)
+{
+    if (!view) {
+        return std::nullopt;
+    }
+    if (!view->selection()) {
+        const int line = view->cursorPosition().line() + 1;
+        return GitForge::LineRange{line, line};
+    }
+
+    const KTextEditor::Range selection = view->selectionRange();
+    return GitForge::selectedLineRange(selection.start().line(), selection.end().line(), selection.end().column());
+}
+}
