+{
+    if (name != QLatin1String("kateprojectplugin") || !pluginView) {
+        return;
+    }
+    m_projectPluginView = pluginView;
+    connect(pluginView,
+            SIGNAL(projectTreeContextMenuAboutToShow(QMenu *, QString, QString, int)),
+            this,
+            SLOT(addProjectContextMenu(QMenu *, QString, QString, int)),
+            Qt::UniqueConnection);
+}
