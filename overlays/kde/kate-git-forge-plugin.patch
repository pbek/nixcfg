+void KateGitForgePluginView::addProjectContextMenu(QMenu *menu, const QString &path, const QString &, int)
+{
+    if (!QFileInfo(path).isFile()) {
+        return;
+    }
+
+    menu->addSeparator();
+    QMenu *forgeMenu = menu->addMenu(QIcon::fromTheme(QStringLiteral("vcs-branch")), i18n("Git Forge"));
+    QAction *detectingAction = forgeMenu->addAction(i18n("Detecting Git forge…"));
+    detectingAction->setEnabled(false);
+
+    auto *watcher = new QFutureWatcher<std::optional<Link>>(forgeMenu);
+    connect(watcher, &QFutureWatcher<std::optional<Link>>::finished, forgeMenu, [forgeMenu, watcher]() {
+        const auto link = watcher->result();
+        watcher->deleteLater();
+        forgeMenu->clear();
+        if (!link) {
+            forgeMenu->menuAction()->setVisible(false);
+            return;
+        }
+        const QString provider = GitForge::providerName(link->provider);
+        forgeMenu->addAction(QIcon::fromTheme(QStringLiteral("internet-web-browser")), i18n("Open on %1", provider), forgeMenu, [url = link->url]() {
+            QDesktopServices::openUrl(url);
+        });
+        forgeMenu->addAction(QIcon::fromTheme(QStringLiteral("edit-copy")), i18n("Copy %1 Link", provider), forgeMenu, [url = link->url]() {
+            QApplication::clipboard()->setText(url.toString(QUrl::FullyEncoded));
+        });
+    });
+    const auto mappings = m_plugin->hostMappings();
+    watcher->setFuture(QtConcurrent::run([path, mappings]() {
+        return linkForFile(path, mappings);
+    }));
+}
+
+std::optional<KateGitForgePluginView::Link> KateGitForgePluginView::linkForFile(const QString &filePath,
+                                                                                const QList<GitForge::HostMapping> &hostMappings,
+                                                                                std::optional<GitForge::LineRange> lines)
+{
+    const QFileInfo fileInfo(filePath);
+    if (!fileInfo.exists() || !fileInfo.isFile()) {
+        return std::nullopt;
+    }
+    const auto root = getRepoBasePath(fileInfo.absolutePath());
+    if (!root) {
+        return std::nullopt;
+    }
+
+    const QString relativePath = QDir(*root).relativeFilePath(fileInfo.absoluteFilePath());
+    if (relativePath == QLatin1String("..") || relativePath.startsWith(QLatin1String("../"))) {
+        return std::nullopt;
+    }
+    if (runGit(*root, {QStringLiteral("ls-files"), QStringLiteral("--error-unmatch"), QStringLiteral("--"), relativePath}).isEmpty()) {
+        return std::nullopt;
+    }
+
+    const QString branch = runGit(*root, {QStringLiteral("symbolic-ref"), QStringLiteral("--quiet"), QStringLiteral("--short"), QStringLiteral("HEAD")});
+    QString remote;
+    QString ref;
+    if (!branch.isEmpty()) {
+        remote = runGit(*root, {QStringLiteral("config"), QStringLiteral("branch.%1.remote").arg(branch)});
+        const QString merge = runGit(*root, {QStringLiteral("config"), QStringLiteral("branch.%1.merge").arg(branch)});
+        if (!remote.isEmpty() && remote != QLatin1String(".") && merge.startsWith(QLatin1String("refs/heads/"))) {
+            ref = merge.sliced(11);
+        } else {
+            remote.clear();
+            ref = branch;
+        }
+    } else {
+        ref = runGit(*root, {QStringLiteral("rev-parse"), QStringLiteral("HEAD")});
+    }
+
+    const QStringList remotes = remoteNames(*root);
+    if (remote.isEmpty()) {
+        if (remotes.contains(QStringLiteral("origin"))) {
+            remote = QStringLiteral("origin");
+        } else if (remotes.size() == 1) {
+            remote = remotes.constFirst();
+        }
+    }
+    if (remote.isEmpty() || ref.isEmpty()) {
+        return std::nullopt;
+    }
+
+    const auto parsedRemote = GitForge::parseRemote(runGit(*root, {QStringLiteral("remote"), QStringLiteral("get-url"), remote}));
+    if (!parsedRemote) {
+        return std::nullopt;
+    }
+    const auto repository = GitForge::resolveRepository(*parsedRemote, hostMappings);
+    if (!repository) {
+        return std::nullopt;
+    }
+    const auto url = GitForge::blobUrl(*repository, ref, QDir::fromNativeSeparators(relativePath), lines);
+    return url ? std::optional<Link>(Link{*url, repository->provider}) : std::nullopt;
+}
+
+void KateGitForgePluginView::updateEditorActions()
+{
+    const quint64 generation = ++m_linkRequestGeneration;
+    m_activeLink.reset();
+    m_openAction->setEnabled(false);
+    m_copyAction->setEnabled(false);
+    m_openAction->setText(i18n("Detecting Git forge…"));
+    m_copyAction->setText(i18n("Copy Git Forge Link"));
+
+    KTextEditor::View *view = m_mainWindow->activeView();
+    if (!view || !view->document()->url().isLocalFile()) {
+        m_openAction->setText(i18n("Open on Git Forge"));
+        return;
+    }
+
+    const QString path = view->document()->url().toLocalFile();
+    const auto lines = activeLines(view);
+    const auto mappings = m_plugin->hostMappings();
+    auto *watcher = new QFutureWatcher<std::optional<Link>>(this);
+    connect(watcher, &QFutureWatcher<std::optional<Link>>::finished, this, [this, watcher, generation]() {
+        const auto link = watcher->result();
+        watcher->deleteLater();
+        if (generation != m_linkRequestGeneration) {
+            return;
+        }
+        m_activeLink = link;
+        m_openAction->setEnabled(link.has_value());
+        m_copyAction->setEnabled(link.has_value());
+        if (link) {
+            const QString provider = GitForge::providerName(link->provider);
+            m_openAction->setText(i18n("Open on %1", provider));
+            m_copyAction->setText(i18n("Copy %1 Link", provider));
+        } else {
+            m_openAction->setText(i18n("Open on Git Forge"));
+        }
+    });
+    watcher->setFuture(QtConcurrent::run([path, mappings, lines]() {
+        return linkForFile(path, mappings, lines);
+    }));
+}
+
+void KateGitForgePluginView::openActiveViewLink()
+{
+    if (m_activeLink) {
+        QDesktopServices::openUrl(m_activeLink->url);
+    }
+}
+
+void KateGitForgePluginView::copyActiveViewLink()
+{
+    if (m_activeLink) {
+        QApplication::clipboard()->setText(m_activeLink->url.toString(QUrl::FullyEncoded));
+    }
+}
