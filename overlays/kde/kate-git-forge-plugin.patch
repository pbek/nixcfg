+*/
+
+#include "gitforgeconfigpage.h"
+#include "kategitforgeplugin.h"
+
+#include <KLocalizedString>
+#include <KMessageBox>
+
+#include <QComboBox>
+#include <QHeaderView>
+#include <QHBoxLayout>
+#include <QIcon>
+#include <QLabel>
+#include <QLineEdit>
+#include <QPushButton>
+#include <QSignalBlocker>
+#include <QTableWidget>
+#include <QVBoxLayout>
+
+GitForgeConfigPage::GitForgeConfigPage(KateGitForgePlugin *plugin, QWidget *parent)
+    : KTextEditor::ConfigPage(parent)
+    , m_plugin(plugin)
+    , m_table(new QTableWidget(this))
+{
+    auto *layout = new QVBoxLayout(this);
+
+    auto *description = new QLabel(
+        i18n("Add mappings for self-hosted GitHub and GitLab servers that Git Forge cannot recognize automatically. The remote host is matched against the "
+             "Git remote URL, and the web base URL is used to create links that open in a browser. GitHub.com, GitLab.com, and invent.kde.org do not need "
+             "entries."),
+        this);
+    description->setWordWrap(true);
+    layout->addWidget(description);
+
+    m_table->setColumnCount(3);
+    m_table->setHorizontalHeaderLabels({i18n("Remote Host"), i18n("Forge"), i18n("Web Base URL")});
+    m_table->horizontalHeaderItem(0)->setToolTip(i18n("The host from the Git remote URL, optionally followed by its SSH port"));
+    m_table->horizontalHeaderItem(1)->setToolTip(i18n("The forge software running on the remote host"));
+    m_table->horizontalHeaderItem(2)->setToolTip(i18n("The HTTP or HTTPS address used to open the forge in a web browser"));
+    m_table->horizontalHeader()->setSectionResizeMode(0, QHeaderView::ResizeToContents);
+    m_table->horizontalHeader()->setSectionResizeMode(1, QHeaderView::ResizeToContents);
+    m_table->horizontalHeader()->setSectionResizeMode(2, QHeaderView::Stretch);
+    m_table->setSelectionBehavior(QAbstractItemView::SelectRows);
+    layout->addWidget(m_table);
+
+    auto *buttons = new QHBoxLayout;
+    auto *addButton = new QPushButton(QIcon::fromTheme(QStringLiteral("list-add")), i18n("Add"), this);
+    auto *removeButton = new QPushButton(QIcon::fromTheme(QStringLiteral("list-remove")), i18n("Remove"), this);
+    buttons->addWidget(addButton);
+    buttons->addWidget(removeButton);
+    buttons->addStretch();
+    layout->addLayout(buttons);
+
+    connect(addButton, &QPushButton::clicked, this, [this]() {
+        addRow();
+        Q_EMIT changed();
+    });
+    connect(removeButton, &QPushButton::clicked, this, [this]() {
+        const auto rows = m_table->selectionModel()->selectedRows();
+        for (auto it = rows.crbegin(); it != rows.crend(); ++it) {
+            m_table->removeRow(it->row());
+        }
+        if (!rows.isEmpty()) {
+            Q_EMIT changed();
+        }
+    });
+    reset();
+}
+
+QString GitForgeConfigPage::name() const
+{
+    return i18n("Git Forge");
+}
+
+QString GitForgeConfigPage::fullName() const
+{
+    return i18n("Git Forge Host Mappings");
+}
+
+QIcon GitForgeConfigPage::icon() const
+{
+    return QIcon::fromTheme(QStringLiteral("vcs-branch"));
+}
+
+void GitForgeConfigPage::apply()
+{
+    QList<GitForge::HostMapping> mappings;
+    for (int row = 0; row < m_table->rowCount(); ++row) {
+        auto *providerBox = qobject_cast<QComboBox *>(m_table->cellWidget(row, 1));
+        auto *hostEdit = qobject_cast<QLineEdit *>(m_table->cellWidget(row, 0));
+        auto *webBaseUrlEdit = qobject_cast<QLineEdit *>(m_table->cellWidget(row, 2));
+        const auto provider = providerBox ? GitForge::providerFromName(providerBox->currentText()) : std::nullopt;
+        const QString host = hostEdit ? hostEdit->text().trimmed() : QString();
+        const QUrl webBaseUrl(webBaseUrlEdit ? webBaseUrlEdit->text().trimmed() : QString(), QUrl::StrictMode);
+        if (!provider) {
+            KMessageBox::error(this, i18n("The forge type in row %1 is invalid.", row + 1));
+            return;
+        }
+        const auto mapping = GitForge::hostMapping(host, *provider, webBaseUrl);
+        if (!mapping) {
+            KMessageBox::error(this, i18n("The remote host or web base URL in row %1 is invalid.", row + 1));
+            return;
+        }
+        mappings.push_back(*mapping);
+    }
+    m_plugin->setHostMappings(mappings);
+}
+
+void GitForgeConfigPage::reset()
+{
+    const QSignalBlocker blocker(m_table);
+    m_table->setRowCount(0);
+    const auto mappings = m_plugin->hostMappings();
+    for (const GitForge::HostMapping &mapping : mappings) {
+        QString host = mapping.host.contains(u':') ? QStringLiteral("[%1]").arg(mapping.host) : mapping.host;
+        if (mapping.port != -1) {
+            host += QStringLiteral(":%1").arg(mapping.port);
+        }
+        addRow(host, GitForge::providerName(mapping.provider), mapping.webBaseUrl.toString(QUrl::FullyEncoded));
+    }
+}
+
+void GitForgeConfigPage::defaults()
+{
+    m_table->setRowCount(0);
+    Q_EMIT changed();
+}
+
+void GitForgeConfigPage::addRow(const QString &host, const QString &provider, const QString &webBaseUrl)
+{
+    const int row = m_table->rowCount();
+    m_table->insertRow(row);
+
+    auto *hostEdit = new QLineEdit(host, m_table);
+    hostEdit->setPlaceholderText(i18n("git.example.com or git.example.com:2222"));
+    hostEdit->setFrame(false);
+    connect(hostEdit, &QLineEdit::textChanged, this, &GitForgeConfigPage::changed);
+    m_table->setCellWidget(row, 0, hostEdit);
+
+    auto *providerBox = new QComboBox(m_table);
+    providerBox->addItems({QStringLiteral("GitHub"), QStringLiteral("GitLab")});
+    providerBox->setCurrentText(provider);
+    connect(providerBox, &QComboBox::currentTextChanged, this, &GitForgeConfigPage::changed);
+    m_table->setCellWidget(row, 1, providerBox);
+
+    auto *webBaseUrlEdit = new QLineEdit(webBaseUrl, m_table);
+    webBaseUrlEdit->setPlaceholderText(i18n("https://git.example.com"));
+    webBaseUrlEdit->setFrame(false);
+    connect(webBaseUrlEdit, &QLineEdit::textChanged, this, &GitForgeConfigPage::changed);
+    m_table->setCellWidget(row, 2, webBaseUrlEdit);
+}
