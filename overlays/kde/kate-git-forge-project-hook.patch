From 40f056252825dbb566d6304c3e3a0a4b609d2641 Mon Sep 17 00:00:00 2001
From: Patrizio Bekerle <patrizio@bekerle.com>
Date: Mon, 21 Sep 2026 11:32:35 +0200
Subject: [PATCH] project: expose file tree context menu extension hook

---
 addons/project/kateprojectpluginview.h            | 6 ++++++
 addons/project/kateprojecttreeviewcontextmenu.cpp | 4 ++++
 addons/project/kateprojectviewtree.h              | 1 +
 3 files changed, 11 insertions(+)

diff --git a/addons/project/kateprojectpluginview.h b/addons/project/kateprojectpluginview.h
index 0fa9c51550..d9c55e84cf 100755
--- a/addons/project/kateprojectpluginview.h
+++ b/addons/project/kateprojectpluginview.h
@@ -17,6 +17,7 @@
 
 class QAction;
 class QDir;
+class QMenu;
 class KateProject;
 class KateProjectPlugin;
 class KateProjectInfoView;
@@ -269,6 +270,11 @@ Q_SIGNALS:
      */
     void projectMapEdited();
 
+    /**
+     * Emitted synchronously before a project tree context menu is shown.
+     */
+    void projectTreeContextMenuAboutToShow(QMenu *menu, const QString &path, const QString &projectBaseDir, int itemType);
+
 private Q_SLOTS:
     /**
      * This slot is called whenever the active view changes in our main window.
diff --git a/addons/project/kateprojecttreeviewcontextmenu.cpp b/addons/project/kateprojecttreeviewcontextmenu.cpp
index 825db1b28d..3fcfc4cd3e 100644
--- a/addons/project/kateprojecttreeviewcontextmenu.cpp
+++ b/addons/project/kateprojecttreeviewcontextmenu.cpp
@@ -12,6 +12,7 @@
 #include "kateproject.h"
 #include "kateprojectinfoviewterminal.h"
 #include "kateprojectitem.h"
+#include "kateprojectpluginview.h"
 #include "kateprojectviewtree.h"
 
 #include <KAuthorized>
@@ -191,6 +192,9 @@ void KateProjectTreeViewContextMenu::exec(const QString &filename, const QModelI
         }
     }
 
+    const int itemType = isRootDirectory ? KateProjectItem::Project : index.data(KateProjectItem::TypeRole).toInt();
+    Q_EMIT parent->m_pluginView->projectTreeContextMenuAboutToShow(&menu, QFileInfo(filename).absoluteFilePath(), parent->project()->baseDir(), itemType);
+
     /**
      * run menu and handle the triggered action
      */
diff --git a/addons/project/kateprojectviewtree.h b/addons/project/kateprojectviewtree.h
index bf3f947cde..151e2e222e 100644
--- a/addons/project/kateprojectviewtree.h
+++ b/addons/project/kateprojectviewtree.h
@@ -23,6 +23,7 @@ class MainWindow;
 class KateProjectViewTree : public QTreeView
 {
     friend class KateProjectTreeDelegate;
+    friend class KateProjectTreeViewContextMenu;
 
 public:
     /**
