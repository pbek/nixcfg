+void RoomManagerTest::testAllChatsInHome()
+{
+    const auto directRoomId = server.createRoom(u"@user:localhost:1234"_s);
+    QSignalSpy syncSpy(connection, &Connection::syncDone);
+    QVERIFY(syncSpy.wait());
+    QVERIFY(syncSpy.wait());
+    auto directRoom = dynamic_cast<NeoChatRoom *>(connection->room(directRoomId));
+    QVERIFY(directRoom);
+    connection->addToDirectChats(directRoom, u"@friend:localhost:1234"_s);
+    QVERIFY(directRoom->isDirectChat());
+
+    // Seed the hierarchy cache to make the normal room a child of a space.
+    const auto spaceId = u"!all-chats-space:localhost:1234"_s;
+    SpaceHierarchyCache::instance().getRoomListForSpace(spaceId, false).append(room->id());
+
+    RoomTreeModel sourceModel;
+    sourceModel.setConnection(connection);
+    SortFilterRoomTreeModel model(&sourceModel);
+    model.setMode(SortFilterRoomTreeModel::Rooms);
+    model.setActiveSpaceId({});
+
+    const auto normalRoomIndex = sourceModel.indexForRoom(room);
+    const auto directRoomIndex = sourceModel.indexForRoom(directRoom);
+    QVERIFY(normalRoomIndex.isValid());
+    QVERIFY(directRoomIndex.isValid());
+
+    // By default, Home hides direct chats and rooms belonging to spaces.
+    // The config changes are not saved, so they only affect this test process.
+    NeoChatConfig::setAllRoomsInHome(false);
+    NeoChatConfig::setAllChatsInHome(false);
+    model.invalidate();
+    QVERIFY(!model.mapFromSource(normalRoomIndex).isValid());
+    QVERIFY(!model.mapFromSource(directRoomIndex).isValid());
+
+    NeoChatConfig::setAllChatsInHome(true);
+    model.invalidate();
+    QVERIFY(model.mapFromSource(normalRoomIndex).isValid());
+    QVERIFY(model.mapFromSource(directRoomIndex).isValid());
+
+    model.setFilterText(u"no matching chat name"_s);
+    QVERIFY(!model.mapFromSource(normalRoomIndex).isValid());
+    QVERIFY(!model.mapFromSource(directRoomIndex).isValid());
+    model.setFilterText({});
+
+    // The space and direct-message views retain their filters.
+    model.setMode(SortFilterRoomTreeModel::All);
+    model.setActiveSpaceId(spaceId);
+    QVERIFY(model.mapFromSource(normalRoomIndex).isValid());
+    QVERIFY(!model.mapFromSource(directRoomIndex).isValid());
+    model.setMode(SortFilterRoomTreeModel::DirectChats);
+    model.setActiveSpaceId(u"DM"_s);
+    QVERIFY(!model.mapFromSource(normalRoomIndex).isValid());
+    QVERIFY(model.mapFromSource(directRoomIndex).isValid());
+
+    // Opening chats from Home keeps Home selected.
+    auto &manager = RoomManager::instance();
+    manager.setProperty("currentSpace", QString());
+    manager.resolveResource(room->id());
+    QCOMPARE(manager.currentRoom(), room);
+    QCOMPARE(manager.currentSpace(), QString());
+    manager.resolveResource(directRoom->id());
+    QCOMPARE(manager.currentRoom(), directRoom);
+    QCOMPARE(manager.currentSpace(), QString());
+
+    // Returning to Home restores its last chat.
+    manager.setProperty("currentSpace", u"DM"_s);
+    manager.setProperty("currentSpace", QString());
+    QCOMPARE(manager.currentRoom(), directRoom);
+    QCOMPARE(manager.currentSpace(), QString());
+
+    NeoChatConfig::setAllChatsInHome(false);
+    SpaceHierarchyCache::instance().getRoomListForSpace(spaceId, false).clear();
+    manager.resetState();
+}
+
 QTEST_MAIN(RoomManagerTest)
 #include "roommanagertest.moc"
