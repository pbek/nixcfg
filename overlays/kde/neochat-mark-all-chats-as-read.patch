 src/libneochat/neochatconnection.h   |  8 +++++
 src/rooms/SpaceDrawer.qml            | 23 ++++++++++++++
 3 files changed, 78 insertions(+)

diff --git a/src/libneochat/neochatconnection.cpp b/src/libneochat/neochatconnection.cpp
index 86a9b5278..33c2929d9 100644
--- a/src/libneochat/neochatconnection.cpp
+++ b/src/libneochat/neochatconnection.cpp
@@ -26,6 +26,7 @@
 #include <Quotient/csapi/registration.h>
 #include <Quotient/csapi/versions.h>
 #include <Quotient/e2ee/sssshandler.h>
+#include <Quotient/events/roomcreateevent.h>
 #include <Quotient/jobs/downloadfilejob.h>
 #include <Quotient/room.h>
 #include <Quotient/settings.h>
@@ -503,6 +504,52 @@ bool NeoChatConnection::homeHaveHighlightNotifications() const
     return false;
 }
 
+void NeoChatConnection::markAllChatsAsRead(bool directChats, bool sendPublicReceipts, bool includeSpaceRooms)
+{
+    const auto &spaceHierarchyCache = SpaceHierarchyCache::instance();
+    for (const auto &r : rooms(JoinState::Join)) {
+        const auto chat = static_cast<NeoChatRoom *>(r);
+        if (chat->isSpace() || chat->isDirectChat() != directChats) {
+            continue;
+        }
+        if (!directChats) {
+            if (!chat->successorId().isEmpty() && room(chat->successorId())) {
+                continue;
+            }
+            if (chat->creation() && !chat->creation()->contentPart<QString>("type"_L1).isEmpty()) {
+                continue;
+            }
+            if (!includeSpaceRooms && spaceHierarchyCache.isChild(chat->id())) {
+                continue;
+            }
+        }
+
+        // Rooms may not have a loaded timeline yet. Fetch an event to mark as read,
+        // just as when marking a space's children as read.
+        if (chat->messageEvents().crbegin() == chat->historyEdge()) {
+            if (!chat->eventsHistoryJob()) {
+                if (chat->allHistoryLoaded()) {
+                    continue;
+                }
+                chat->getPreviousContent();
+            }
+
+            connect(
+                chat,
+                &NeoChatRoom::addedMessages,
+                chat,
+                [chat, sendPublicReceipts] {
+                    if (chat->messageEvents().crbegin() != chat->historyEdge()) {
+                        chat->markAllMessagesAsRead(sendPublicReceipts);
+                    }
+                },
+                Qt::SingleShotConnection);
+        } else {
+            chat->markAllMessagesAsRead(sendPublicReceipts);
+        }
+    }
+}
+
 qsizetype NeoChatConnection::directChatInvites() const
 {
     const auto inviteRooms = rooms(JoinState::Invite);
diff --git a/src/libneochat/neochatconnection.h b/src/libneochat/neochatconnection.h
