+     * @param directChats Whether to mark direct chats instead of Home rooms.
+     * @param sendPublicReceipts Whether to send public read receipts.
+     * @param includeSpaceRooms Whether Home includes rooms belonging to spaces.
+     */
+    Q_INVOKABLE void markAllChatsAsRead(bool directChats, bool sendPublicReceipts, bool includeSpaceRooms = false);
+
     int badgeNotificationCount() const;
